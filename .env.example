# Copy to .env and fill in to enable LIVE GenAI attack generation.
# The pipeline and web app also run fully offline from the committed artifact cache
# (artifacts_cache/) and seeded dataset — no key required for that path.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
FRAUD_LAB_MODEL=claude-sonnet-5
FRAUD_LAB_LLM_ENABLED=1
